---
// NavBar.astro
---

<header class="border-b hairline-border sticky top-0 z-40 bg-[var(--bg-main)]/95 backdrop-blur-sm">
  <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
    <div class="flex items-center gap-6">
      <a href="#" class="block">
        <span id="nav-rubro-tag" class="block font-mono text-[10px] uppercase tracking-[0.22em] text-stone-500">ESTUDIO & BIENESTAR · SURQUILLO</span>
        <span id="nav-name" class="font-serif text-2xl sm:text-3xl font-semibold tracking-tight leading-none block mt-0.5">Benny Salón & Spa</span>
      </a>
    </div>
    <nav class="hidden md:flex items-center gap-8 text-xs uppercase tracking-[0.15em] font-medium text-stone-600">
      <a href="#carta" class="hover:text-black transition" id="nav-menu-label">Carta de Servicios</a>
      <a href="#galeria" class="hover:text-black transition">Resultados & Estudio</a>
      <a href="#ubicacion" class="hover:text-black transition">Ubicación</a>
    </nav>
    <a href="#carta" class="btn-editorial px-4 py-2.5 text-xs uppercase tracking-[0.12em] font-semibold">
      <span id="nav-cta-text">Reservar Turno</span>
    </a>
  </div>
</header>
