---
// VeterinaryView.astro — Vista veterinaria inspirada en Aristocat y Veterinaria Flores
---

<div id="veterinary-prototype-view" class="prototype-view" style="display: none;">
  <!-- Barra de Urgencias Médicas 24 Horas (Estilo Aristocat & Flores) -->
  <aside aria-label="Aviso de urgencias" class="bg-red-700 text-white text-xs font-mono py-2 px-4 shadow-md sticky top-0 z-50">
    <div class="max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <span class="inline-block w-2.5 h-2.5 rounded-full bg-white animate-ping"></span>
        <span class="inline-flex items-center gap-1.5 font-bold tracking-wider">
          <svg class="w-4 h-4 text-white inline-block shrink-0 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
          URGENCIAS VETERINARIAS 24 HORAS:
        </span>
        <span class="hidden sm:inline text-red-100">Guardia médica activa en clínica. Si tu mascota tiene una emergencia, llámanos de inmediato.</span>
      </div>
      <a id="vet-top-call" href="#" class="bg-white text-red-700 hover:bg-red-50 px-3 py-0.5 rounded-full text-[11px] font-bold tracking-wider transition">
        LLAMAR DE URGENCIA →
      </a>
    </div>
  </aside>

  <!-- Cabecera Médica Mint & Blanco Clínico -->
  <header class="border-b border-teal-100 bg-white/95 backdrop-blur-md text-stone-800 sticky top-8 z-40 shadow-xs">
    <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="p-1.5 rounded-xl bg-teal-50/60 border border-teal-200 shadow-xs flex items-center">
          <img id="vet-nav-logo" src="/logos/p003-mikelas.svg" alt="Logotipo Oficial" class="h-10 sm:h-12 w-auto max-w-[200px] object-contain" />
        </div>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-mono bg-teal-50 text-teal-800 font-semibold border border-teal-200 hidden sm:inline-flex">
          <span class="w-2 h-2 rounded-full bg-teal-500 animate-pulse"></span> Consultorio &amp; Tópico Abierto
        </span>
      </div>

      <nav class="hidden md:flex items-center gap-6 text-xs uppercase tracking-[0.14em] font-medium text-stone-600">
        <a href="#vet-nosotros" class="hover:text-teal-700 transition-colors">Nosotros</a>
        <a href="#vet-triaje" class="hover:text-teal-700 transition-colors">Ficha Express</a>
        <a href="#vet-protocolos" class="hover:text-teal-700 transition-colors">Protocolos</a>
        <a href="#vet-calculadora-vacunas" class="hover:text-teal-700 transition-colors">Vacunas</a>
        <a href="#vet-semaforo-urgencias" class="hover:text-teal-700 transition-colors">Urgencias</a>
        <a href="#vet-tarifario" class="hover:text-teal-700 transition-colors">Tarifario</a>
        <a id="vet-social-pill" href="#" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-mono border border-teal-200 bg-teal-50 text-teal-800 hover:border-teal-400 hover:bg-teal-100 transition">
          <span class="w-1.5 h-1.5 rounded-full bg-teal-600"></span>
          <span id="vet-social-text">@veterinaria</span>
        </a>
      </nav>

      <a href="#vet-triaje" class="bg-teal-600 hover:bg-teal-700 text-white font-bold px-5 py-2.5 rounded-full text-xs uppercase tracking-[0.14em] shadow-md shadow-teal-900/10 transition">
        <span>Agendar Cita</span>
      </a>
    </div>
  </header>

  <!-- Hero Veterinario Luminoso, Afectuoso & Profesional (Estilo Aristocat & Flores) -->
  <section class="relative overflow-hidden bg-gradient-to-b from-[#f0fdfa] via-[#ecfdf5]/50 to-white text-stone-900 border-b border-teal-100">
    <div class="absolute -top-32 right-1/4 w-[500px] h-[500px] rounded-full opacity-30 pointer-events-none blur-3xl bg-teal-200"></div>

    <div class="max-w-6xl mx-auto px-4 py-16 sm:py-24 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <!-- Columna Izquierda: Copy de Cuidado y Confianza UNMSM -->
        <div class="lg:col-span-7 space-y-6">
          <div class="flex flex-wrap items-center gap-2.5">
            <span class="inline-flex items-center gap-2 border border-teal-300 px-3.5 py-1 bg-white/90 rounded-full font-mono text-[11px] uppercase tracking-wider text-teal-800 shadow-xs">
              <span class="w-2 h-2 rounded-full bg-teal-500 animate-pulse"></span>
              <span id="vet-hero-kicker">MÉDICOS VETERINARIOS TITULADOS UNMSM · CMVP</span>
            </span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-mono bg-teal-100/70 text-teal-900 border border-teal-200 font-semibold">
              <svg class="w-3.5 h-3.5 text-teal-700 inline-block shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12 10c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm-4.5-1c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm9 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm-4.5 6.5c-2.33 0-4.32 1.45-5.12 3.5h10.24c-.8-2.05-2.79-3.5-5.12-3.5zM4.5 13c-.83 0-1.5.67-1.5 1.5S3.67 16 4.5 16s1.5-.67 1.5-1.5S5.33 13 4.5 13zm15 0c-.83 0-1.5.67-1.5 1.5s.67 1.5 1.5 1.5 1.5-.67 1.5-1.5-.67-1.5-1.5-1.5z"/></svg>
              Cuidado con Amor Real
            </span>
          </div>

          <h1 class="font-serif text-4xl sm:text-6xl lg:text-[58px] font-extrabold leading-[1.06] tracking-tight text-stone-950">
            <span id="vet-hero-title">El bienestar de tu engreído en</span>
            <em id="vet-hero-sub" class="font-normal italic block mt-1 text-transparent bg-clip-text bg-gradient-to-r from-teal-700 via-emerald-600 to-teal-800">Veterinaria Mikelas.</em>
          </h1>

          <!-- Lema Oficial -->
          <blockquote class="border-l-4 border-teal-600 pl-4 py-2 italic font-serif text-lg sm:text-xl text-stone-800 bg-white/80 rounded-r-xl border border-teal-100 shadow-xs">
            <span id="vet-hero-lema">«Médicos Veterinarios egresados de la UNMSM, comprometidos en velar por el bienestar de tu engreído con mucho amor en Pueblo Libre.»</span>
          </blockquote>

          <p id="vet-hero-lead" class="text-stone-600 text-base sm:text-lg leading-relaxed max-w-xl font-normal">
            Atención clínica preventiva, vacunación séxtuple y triple felina, desparasitación completa, cirugías con anestesia inhalatoria y baños medicados en un ambiente seguro, higiénico y libre de estrés.
          </p>

          <!-- CTAs -->
          <div class="pt-4 flex flex-wrap items-center gap-4">
            <a href="#vet-triaje" class="bg-teal-600 hover:bg-teal-700 text-white font-bold px-8 py-4 rounded-full text-xs sm:text-sm uppercase tracking-[0.15em] shadow-lg shadow-teal-900/15 inline-flex items-center gap-3 transition transform hover:scale-[1.02]">
              <span>Llenar Ficha Médica Express</span>
              <span>↓</span>
            </a>
            <a href="#vet-tarifario" class="px-7 py-4 border border-teal-200 hover:border-teal-400 text-xs sm:text-sm uppercase tracking-[0.12em] font-bold transition bg-white text-teal-900 rounded-full shadow-xs">
              Ver Tarifario de Salud
            </a>
          </div>

          <!-- Métricas de Confianza Médica -->
          <div class="grid grid-cols-3 gap-4 pt-6 border-t border-teal-100 font-mono">
            <div>
              <span class="block text-[10px] uppercase tracking-wider text-stone-500">CALIFICACIÓN</span>
              <span class="text-lg sm:text-xl font-bold text-teal-800"><span id="vet-stat-rating">4.8</span> / 5.0 ★</span>
            </div>
            <div class="border-l border-teal-100 pl-4">
              <span class="block text-[10px] uppercase tracking-wider text-stone-500">PACIENTES FELICES</span>
              <span class="text-lg sm:text-xl font-bold text-stone-900" id="vet-stat-reviews">+1,300 familias</span>
            </div>
            <div class="border-l border-teal-100 pl-4">
              <span class="block text-[10px] uppercase tracking-wider text-stone-500">DISTRITO</span>
              <span class="text-lg sm:text-xl font-bold text-stone-900" id="vet-stat-zone">Pueblo Libre</span>
            </div>
          </div>
        </div>

        <!-- Columna Derecha: Paciente en Consulta -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden border-2 border-teal-200 shadow-xl shadow-teal-900/10 group">
            <img id="vet-hero-photo" src="https://images.unsplash.com/photo-1583337130417-3346a1be7dee?auto=format&fit=crop&w=1200&q=85" alt="Paciente en consulta" class="w-full aspect-[4/4.8] object-cover group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute inset-0 bg-gradient-to-t from-stone-950/80 via-stone-950/20 to-transparent pointer-events-none"></div>

            <div class="absolute top-4 left-4 bg-teal-600 text-white font-mono text-[10px] font-bold uppercase tracking-wider px-3 py-1 rounded-full shadow-md">
              🩺 ATENCIÓN PROFESIONAL UNMSM
            </div>

            <div class="absolute bottom-4 left-4 right-4 bg-white/95 backdrop-blur-md p-5 border border-teal-100 rounded-2xl shadow-xl text-stone-800">
              <div class="flex items-center justify-between">
                <span class="font-mono text-[10px] uppercase tracking-widest text-teal-700 font-bold" id="vet-featured-label">CONSULTA COMPLETA</span>
                <span class="font-mono text-base font-extrabold text-teal-800" id="vet-featured-price">S/ 40</span>
              </div>
              <h2 class="font-serif text-xl font-bold mt-1 text-stone-950" id="vet-featured-title">Chequeo Clínico Integral</h2>
              <p class="text-xs text-stone-600 mt-1 line-clamp-2" id="vet-featured-sub">Examen físico de cabeza a cola, signos vitales, control de peso, oídos y dentadura.</p>
              <div class="mt-3 pt-3 border-t border-teal-100 flex items-center justify-between text-[11px] font-mono text-stone-500">
                <span id="vet-address-caption">Pueblo Libre</span>
                <span class="text-teal-700 font-bold">Sin estrés</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Cinta Ticker Veterinaria -->
  <div class="border-b border-teal-900/40 py-3 overflow-hidden bg-teal-900 text-teal-100 text-[11px] font-mono uppercase tracking-[0.22em]">
    <div class="marquee-track" id="vet-marquee-content">
      <span class="mx-6 font-semibold">✦ MÉDICOS VETERINARIOS TITULADOS UNMSM</span>
      <span class="mx-6 font-semibold text-white">✦ BAÑOS RELAJANTES &amp; GROOMING SIN SEDANTES</span>
      <span class="mx-6 font-semibold text-teal-300">✦ VACUNAS &amp; DESPARASITACIÓN CON REGISTRO OFICIAL</span>
      <span class="mx-6 font-semibold text-white">✦ CONSULTAS RÁPIDAS POR WHATSAPP</span>
      <span class="mx-6 font-semibold text-teal-200">✦ FARMACIA Y PET SHOP ESPECIALIZADO</span>
      <span class="mx-6 font-semibold text-white">✦ QUIRÓFANO Y HOSPITALIZACIÓN EQUIPADA</span>
    </div>
  </div>

  <!-- SECCIÓN SOBRE NOSOTROS: QUIÉNES SOMOS & VOCACIÓN MÉDICA -->
  <section id="vet-nosotros" class="py-16 sm:py-24 px-4 bg-white text-stone-900 border-b border-teal-100">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      <div class="lg:col-span-7 space-y-6">
        <div class="space-y-2">
          <span id="vet-about-kicker" class="font-mono text-xs uppercase tracking-[0.25em] text-teal-700 font-bold">
            CIENCIA CLÍNICA, ÉTICA &amp; AMOR ANIMAL
          </span>
          <h2 id="vet-about-title" class="font-serif text-3xl sm:text-5xl font-extrabold text-stone-950 leading-tight">
            Quiénes Somos: Pasión Médica al Servicio de tu Familia
          </h2>
        </div>

        <p id="vet-about-p1" class="text-stone-700 text-sm sm:text-base leading-relaxed font-sans">
          Somos un equipo de <strong>Médicos Veterinarios colegiados egresados de la Universidad Nacional Mayor de San Marcos (UNMSM) y UPCH</strong>. Entendemos que tu mascota no es solo un paciente: es un integrante irremplazable de tu hogar que merece el más alto estándar de atención médica y compasión.
        </p>

        <p id="vet-about-p2" class="text-stone-600 text-xs sm:text-sm leading-relaxed font-sans">
          Trabajamos bajo el estándar internacional de <em>Manejo Sin Estrés («Fear-Free»)</em>: jamás recurrimos a la sedación para procedimientos estéticos o baños, y procuramos un ambiente tranquilo, sin olores intimidantes y con recompensas positivas en cada etapa de la consulta.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 font-mono text-xs">
          <div class="p-4 rounded-2xl bg-teal-50/70 border border-teal-200 flex items-start gap-3">
            <div class="w-8 h-8 rounded-xl bg-teal-100 text-teal-800 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5" />
              </svg>
            </div>
            <div>
              <strong class="text-teal-950 block font-sans text-sm">Médicos Colegiados CMVP</strong>
              <span class="text-stone-600 text-[11px]">Titulados con formación continua en medicina interna y cirugía de tejidos blandos.</span>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-emerald-50/70 border border-emerald-200 flex items-start gap-3">
            <div class="w-8 h-8 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <div>
              <strong class="text-emerald-950 block font-sans text-sm">Cero Sedación en Spa &amp; Baños</strong>
              <span class="text-stone-600 text-[11px]">Paciencia, agua temperada y trato cariñoso para cuidar su salud cardíaca.</span>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-teal-50/70 border border-teal-200 flex items-start gap-3">
            <div class="w-8 h-8 rounded-xl bg-teal-100 text-teal-800 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
              </svg>
            </div>
            <div>
              <strong class="text-teal-950 block font-sans text-sm">Cadena de Frío Digital 24/7</strong>
              <span class="text-stone-600 text-[11px]">Biológicos originales (Zoetis, MSD) con eficacia inmunológica garantizada.</span>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-emerald-50/70 border border-emerald-200 flex items-start gap-3">
            <div class="w-8 h-8 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <div>
              <strong class="text-emerald-950 block font-sans text-sm">Quirófano Inhalatorio Seguro</strong>
              <span class="text-stone-600 text-[11px]">Monitoreo multiparámetro cardíaco y saturación continua en cada intervención.</span>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-5 relative">
        <div class="relative rounded-3xl overflow-hidden border-2 border-teal-200 shadow-xl shadow-teal-900/10">
          <img src="https://images.unsplash.com/photo-1628009368231-7bb7cfcb0def?auto=format&fit=crop&w=900&q=85" alt="Médico Veterinario con Paciente" class="w-full aspect-[4/5] object-cover" />
          <div class="absolute inset-0 bg-gradient-to-t from-stone-950/80 via-stone-950/20 to-transparent"></div>

          <div class="absolute bottom-6 left-6 right-6 bg-white/95 backdrop-blur-md p-5 rounded-2xl border border-teal-100 text-stone-800 space-y-2 shadow-xl">
            <div class="flex items-center gap-2 text-teal-800 font-mono text-xs font-bold uppercase">
              <span>✦</span> <span>JURAMENTO VETERINARIO</span>
            </div>
            <p class="font-serif text-base italic text-stone-900">
              «Dedicar nuestros conocimientos al alivio del dolor animal y a la prevención de enfermedades con empatía humana.»
            </p>
            <p class="font-mono text-[10px] text-stone-500 uppercase tracking-widest pt-1 border-t border-teal-100">
              — Cuerpo Médico Veterinario Titulado
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECCIÓN 1: WIDGET INTERACTIVO DE TRIAJE MÉDICO EXPRESS (El Corazón de Aristocat & Flores) -->
  <section id="vet-triaje" class="py-16 sm:py-24 px-4 bg-[#f8fafc] text-stone-900 border-b border-teal-100">
    <div class="max-w-5xl mx-auto">
      <div class="text-center max-w-2xl mx-auto space-y-2 mb-12">
        <span class="font-mono text-xs uppercase tracking-[0.25em] text-teal-700 font-bold">FICHA MÉDICA EXPRESS</span>
        <h2 class="font-serif text-3xl sm:text-5xl font-extrabold text-stone-950">Agenda la Cita de tu Engreído</h2>
        <p class="text-stone-600 text-sm leading-relaxed">
          Cuéntanos sobre tu mascota para que el médico veterinario tenga su ficha lista antes de tu llegada.
        </p>
      </div>

      <div class="bg-white border-2 border-teal-200 rounded-3xl p-6 sm:p-12 shadow-xl space-y-8">
        <!-- Paso 1: Tipo de Mascota -->
        <div>
          <span class="block font-mono text-xs uppercase tracking-wider text-teal-900 font-bold mb-3">
            PASO 1: ¿QUIÉN ES TU ENGREÍDO?
          </span>
          <div class="grid grid-cols-3 gap-3 font-mono text-sm">
            <button id="vet-pet-dog" type="button" class="vet-pet-btn py-4 px-3 rounded-2xl border-2 border-teal-600 bg-teal-50 text-teal-950 font-bold flex flex-col items-center justify-center gap-2 hover:bg-teal-100 transition cursor-pointer">
              <svg class="w-8 h-8 text-teal-800" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 10c-1.5 0-3 1.5-3 3.5S4.5 17 6 17m12-7c1.5 0 3 1.5 3 3.5S19.5 17 18 17M6 10c0-3 2.5-6 6-6s6 3 6 6m-12 0v5a6 6 0 0012 0v-5M9 11h.01M15 11h.01M11 14h2" />
              </svg>
              <span>Perrito</span>
            </button>
            <button id="vet-pet-cat" type="button" class="vet-pet-btn py-4 px-3 rounded-2xl border-2 border-stone-200 bg-stone-50 text-stone-700 font-bold flex flex-col items-center justify-center gap-2 hover:bg-teal-50 hover:border-teal-300 transition cursor-pointer">
              <svg class="w-8 h-8 text-stone-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 5l3 4h10l3-4v8a7 7 0 01-14 0V5zM9 13h.01M15 13h.01M11 16h2M2 13h4m12 0h4" />
              </svg>
              <span>Gatito</span>
            </button>
            <button id="vet-pet-other" type="button" class="vet-pet-btn py-4 px-3 rounded-2xl border-2 border-stone-200 bg-stone-50 text-stone-700 font-bold flex flex-col items-center justify-center gap-2 hover:bg-teal-50 hover:border-teal-300 transition cursor-pointer">
              <svg class="w-8 h-8 text-stone-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 3c-1.5 2-1 6 1 7m8-7c1.5 2 1 6-1 7m-8 0a6 6 0 108 0c-1-1-7-1-8 0zm3 5h.01M13 15h.01M11 18h2" />
              </svg>
              <span>Exótico / Otro</span>
            </button>
          </div>
        </div>

        <!-- Paso 2: Datos del Paciente -->
        <div>
          <span class="block font-mono text-xs uppercase tracking-wider text-teal-900 font-bold mb-3">
            PASO 2: DATOS DEL PACIENTE
          </span>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 font-mono text-xs">
            <div>
