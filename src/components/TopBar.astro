---
// TopBar.astro
---

<div class="border-b hairline-border text-[11px] py-2 px-4 bg-surface-alt">
  <div class="max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-2">
    <div class="flex items-center gap-2 text-stone-700">
      <span class="inline-block w-2 h-2 rounded-full bg-emerald-600"></span>
      <span id="topbar-address" class="font-medium">Jr. Narciso de la Colina 869, Surquillo</span>
    </div>
    <div class="flex items-center gap-4 font-mono text-stone-600">
      <span>★ <strong id="topbar-rating" class="text-stone-900">4.7</strong> (<span id="topbar-reviews">más de 100</span> reseñas en Google)</span>
      <a id="topbar-phone" href="tel:012340267" class="underline hover:text-black hidden sm:inline">Tel: (01) 2340267</a>
    </div>
  </div>
</div>
