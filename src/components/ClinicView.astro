---
// ClinicView.astro — Vista clínica y dental inspirada en centros odontológicos de prestigio
---

<div id="clinic-prototype-view" class="prototype-view" style="display: none;">
  <!-- Cintillo de Bioseguridad y Respaldo COP -->
  <div class="bg-cyan-950 text-cyan-100 text-[11px] font-mono py-1.5 px-4 border-b border-cyan-900">
    <div class="max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <span class="inline-block w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
        <span>Especialistas Colegiados COP · Bioseguridad Hospitalaria Clase B · Esterilización Digital</span>
      </div>
      <div class="flex items-center gap-4">
        <span>Urgencias &amp; Consultas: <strong id="clinic-top-phone" class="text-white">Teléfono</strong></span>
      </div>
    </div>
  </div>

  <!-- Cabecera Odontológica / Clínica -->
  <header class="border-b hairline-border sticky top-0 z-40 bg-[var(--bg-main)]/95 backdrop-blur-md">
    <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <img id="clinic-nav-logo" src="/logos/p137-mundo-odontic.svg" alt="Logotipo Oficial" class="h-10 sm:h-12 w-auto max-w-[240px] object-contain" />
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-mono bg-cyan-100/90 text-cyan-800 font-semibold border border-cyan-300 hidden sm:inline-flex">
          <span class="w-2 h-2 rounded-full bg-cyan-500"></span> Citas Médicas Hoy
        </span>
      </div>

      <nav class="hidden md:flex items-center gap-6 text-xs uppercase tracking-[0.14em] font-medium text-stone-600">
        <a href="#clinic-nosotros" class="hover:text-[var(--accent)] transition-colors">Nosotros</a>
        <a href="#clinic-especialidades" class="hover:text-[var(--accent)] transition-colors">Especialidades</a>
        <a href="#clinic-tecnologia" class="hover:text-[var(--accent)] transition-colors">Bioseguridad</a>
        <a href="#clinic-financiamiento" class="hover:text-[var(--accent)] transition-colors">Facilidades</a>
        <a href="#clinic-tarifario" class="hover:text-[var(--accent)] transition-colors">Tarifario</a>
        <a href="#clinic-ubicacion" class="hover:text-[var(--accent)] transition-colors">Sede</a>
        <a id="clinic-social-pill" href="#" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-mono border hairline-border bg-[var(--bg-alt)] hover:border-stone-800 transition">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>
          <span id="clinic-social-text">@odontologia</span>
        </a>
      </nav>

      <a href="#clinic-tarifario" class="btn-editorial px-5 py-2.5 text-xs uppercase tracking-[0.12em] font-semibold">
        <span>Agendar Consulta</span>
      </a>
    </div>
  </header>

  <!-- Hero Odontológico / Clínico -->
  <section class="border-b hairline-border relative overflow-hidden bg-gradient-to-b from-[var(--bg-main)] to-[var(--bg-alt)]/40">
    <div class="absolute -top-32 -right-32 w-[420px] h-[420px] rounded-full opacity-25 pointer-events-none blur-3xl bg-[var(--accent)]"></div>

    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 relative z-10">
      <!-- Columna Izquierda -->
      <div class="lg:col-span-7 p-6 sm:p-10 lg:p-14 flex flex-col justify-between border-b lg:border-b-0 lg:border-r hairline-border">
        <div class="space-y-6">
          <div class="flex flex-wrap items-center gap-2.5">
            <span class="inline-flex items-center gap-2 border hairline-border px-3 py-1 bg-white rounded-full font-mono text-[11px] uppercase tracking-wider text-stone-800 shadow-2xs">
              <span class="w-2 h-2 rounded-full bg-[var(--accent)]"></span>
              <span id="clinic-hero-kicker">CENTRO CLÍNICO ESPECIALIZADO</span>
            </span>
            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-mono bg-cyan-100 text-cyan-900 border border-cyan-300 font-semibold">
              ✦ Diagnóstico Digital 3D
            </span>
          </div>

          <h1 class="font-serif text-4xl sm:text-6xl lg:text-[58px] font-semibold leading-[1.04] tracking-tight text-[var(--ink)]">
            <span id="clinic-hero-title">Tu salud y sonrisa en manos de</span>
            <em id="clinic-hero-sub" class="font-normal italic block mt-1 text-[var(--accent)]">Mundo Odontic.</em>
          </h1>

          <blockquote class="border-l-3 border-[var(--accent)] pl-4 py-1 italic font-serif text-lg sm:text-xl text-stone-800 bg-white/60 rounded-r-md">
            <span id="clinic-hero-lema">«Expertos en ortodoncia, rehabilitación oral y estética dental con tecnología de vanguardia y atención personalizada.»</span>
          </blockquote>

          <p id="clinic-hero-lead" class="text-stone-600 text-base sm:text-lg leading-relaxed max-w-xl font-normal">
            Tratamientos indoloros guiados con tecnología digital, instrumental esterilizado bajo norma hospitalaria y especialistas de postgrado. Revisa nuestro tarifario y asegura tu evaluación.
          </p>
        </div>

        <div class="pt-8 mt-8 border-t hairline-border space-y-6">
          <div class="flex flex-wrap items-center gap-3">
            <a href="#clinic-tarifario" class="btn-editorial px-7 py-4 text-xs sm:text-sm uppercase tracking-[0.14em] font-semibold inline-flex items-center gap-3 shadow-md">
              <span>Ver Tarifario &amp; Agendar</span>
              <span>↓</span>
            </a>
            <a href="#clinic-ubicacion" class="px-6 py-4 border hairline-border hover:border-stone-900 text-xs sm:text-sm uppercase tracking-[0.12em] font-medium transition bg-white/80">
              Ubicación de la Clínica
            </a>
          </div>

          <!-- Ficha de Confianza Médica -->
          <div class="grid grid-cols-3 gap-4 pt-2 font-mono">
            <div>
              <span class="block text-[10px] uppercase tracking-wider text-stone-500">CALIFICACIÓN</span>
              <span class="text-base sm:text-lg font-semibold"><span id="clinic-stat-rating">4.8</span> / 5.0 ★</span>
            </div>
            <div class="border-l hairline-border pl-4">
              <span class="block text-[10px] uppercase tracking-wider text-stone-500">PACIENTES</span>
              <span class="text-base sm:text-lg font-semibold" id="clinic-stat-reviews">+1,000 atendidos</span>
            </div>
            <div class="border-l hairline-border pl-4">
              <span class="block text-[10px] uppercase tracking-wider text-stone-500">DISTRITO</span>
              <span class="text-base sm:text-lg font-semibold" id="clinic-stat-zone">Jesús María</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Columna Derecha: Foto de la Clínica / Tratamiento -->
      <div class="lg:col-span-5 flex flex-col justify-between bg-surface-alt">
        <div class="relative aspect-[4/4.8] w-full overflow-hidden border-b hairline-border group">
          <img id="clinic-hero-photo" src="https://images.unsplash.com/photo-1629909613654-28e377c37b09?auto=format&fit=crop&w=1200&q=85" alt="Clínica y Especialistas" class="w-full h-full object-cover contrast-[1.03] transition-transform duration-700 group-hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent pointer-events-none"></div>

          <div class="absolute bottom-4 left-4 right-4 bg-white/95 backdrop-blur-md p-4 border hairline-border shadow-xl rounded-sm">
            <div class="flex items-center justify-between">
              <span class="font-mono text-[10px] uppercase tracking-widest text-stone-500 font-bold" id="clinic-featured-label">TRATAMIENTO ESTRELLA</span>
              <span class="font-mono text-sm font-semibold text-[var(--accent)]" id="clinic-featured-price">S/ 180</span>
            </div>
            <h4 class="font-serif text-lg font-semibold text-stone-900 mt-1" id="clinic-featured-title">Limpieza Profunda Ultrasónica + Profilaxis</h4>
            <p class="text-xs text-stone-600 mt-0.5" id="clinic-featured-sub">Eliminación completa de sarro y pulido dental sin dolor ni sensibilidad.</p>
          </div>
        </div>

        <div class="p-4 sm:p-6 bg-white flex items-center justify-between text-xs font-mono">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-cyan-600"></span>
            <span id="clinic-address-caption" class="text-stone-700 truncate max-w-[280px]">Av. Arnaldo Márquez 1234</span>
          </div>
          <span class="text-[var(--accent)] font-semibold">Citas Programadas →</span>
        </div>
      </div>
    </div>
  </section>

  <!-- SECCIÓN SOBRE NOSOTROS: DIRECCIÓN MÉDICA & RESPALDO CLÍNICO -->
  <section id="clinic-nosotros" class="border-b hairline-border py-16 sm:py-24 px-4 bg-[var(--bg-main)]">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      <div class="lg:col-span-7 space-y-6">
        <div class="space-y-2">
          <span id="clinic-about-kicker" class="font-mono text-xs uppercase tracking-[0.25em] text-[var(--accent)] font-semibold">
            RESPALDO PROFESIONAL COP &amp; BIOSEGURIDAD
          </span>
          <h2 id="clinic-about-title" class="font-serif text-3xl sm:text-5xl font-semibold text-stone-900 leading-tight">
            Quiénes Somos: Odontología Ética con Respaldo Científico
          </h2>
        </div>

        <p id="clinic-about-p1" class="text-stone-700 text-sm sm:text-base leading-relaxed font-sans">
          Somos un centro odontológico y clínico conformado por <strong>cirujanos dentistas colegiados y especialistas con registro nacional RNE</strong>. Nuestro compromiso es brindar una atención cálida, transparente y 100% indolora, sustentada en evidencia científica y tecnología de imagenología digital.
        </p>

        <p id="clinic-about-p2" class="text-stone-600 text-xs sm:text-sm leading-relaxed font-sans">
          Rechazamos los tratamientos sobreindicados o innecesarios. En cada consulta explicamos detalladamente tu radiografía digital en pantalla, ofreciéndote un diagnóstico honesto, opciones claras de presupuesto y un plan de tratamiento que prioriza siempre la conservación de tus piezas naturales.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 font-mono text-xs">
          <div class="p-4 rounded-sm bg-white border hairline-border flex items-start gap-3 shadow-xs">
            <div class="w-8 h-8 rounded bg-cyan-50 border border-cyan-200 flex items-center justify-center text-[var(--accent)] shrink-0">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path d="M12 14l9-5-9-5-9 5 9 5z" />
                <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
              </svg>
            </div>
            <div>
              <strong class="text-stone-900 block font-sans">Especialistas Colegiados COP</strong>
              <span class="text-stone-500 text-[11px]">Con postgrados en ortodoncia, rehabilitación oral y estética.</span>
            </div>
          </div>

          <div class="p-4 rounded-sm bg-white border hairline-border flex items-start gap-3 shadow-xs">
            <div class="w-8 h-8 rounded bg-cyan-50 border border-cyan-200 flex items-center justify-center text-[var(--accent)] shrink-0">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <div>
              <strong class="text-stone-900 block font-sans">Autoclave Hospitalario Clase B</strong>
              <span class="text-stone-500 text-[11px]">Sobres de instrumental sellados que se abren en tu presencia.</span>
            </div>
          </div>

          <div class="p-4 rounded-sm bg-white border hairline-border flex items-start gap-3 shadow-xs">
            <div class="w-8 h-8 rounded bg-cyan-50 border border-cyan-200 flex items-center justify-center text-[var(--accent)] shrink-0">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <strong class="text-stone-900 block font-sans">Protocolo Cero Dolor</strong>
              <span class="text-stone-500 text-[11px]">Técnicas anestésicas tópicas que garantizan sesiones sin ansiedad.</span>
            </div>
          </div>

          <div class="p-4 rounded-sm bg-white border hairline-border flex items-start gap-3 shadow-xs">
            <div class="w-8 h-8 rounded bg-cyan-50 border border-cyan-200 flex items-center justify-center text-[var(--accent)] shrink-0">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <div>
              <strong class="text-stone-900 block font-sans">Presupuestos Claros Sin Sorpresas</strong>
              <span class="text-stone-500 text-[11px]">Desglose transparente antes de iniciar cualquier procedimiento.</span>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-5 relative">
        <div class="relative rounded-sm overflow-hidden border hairline-border shadow-xl">
          <img src="https://images.unsplash.com/photo-1629909613654-28e377c37b09?auto=format&fit=crop&w=900&q=85" alt="Consulta Odontológica Profesional" class="w-full aspect-[4/5] object-cover" />
          <div class="absolute inset-0 bg-gradient-to-t from-stone-950/80 via-transparent to-transparent"></div>

          <div class="absolute bottom-6 left-6 right-6 bg-white/95 backdrop-blur-md p-5 rounded-sm border hairline-border text-stone-800 space-y-2 shadow-lg">
            <div class="flex items-center gap-2 text-[var(--accent)] font-mono text-xs font-semibold uppercase">
              <span>✦</span> <span>MISIÓN CLÍNICA INSTITUCIONAL</span>
            </div>
            <p class="font-serif text-base italic text-stone-900">
              «Devolver la confianza al sonreír, combinando calidez humana con bioseguridad absoluta.»
            </p>
            <p class="font-mono text-[10px] text-stone-500 uppercase tracking-widest pt-1 border-t hairline-border">
              — Dirección Médica &amp; Especialistas
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 Especialidades Médicas -->
  <section id="clinic-especialidades" class="border-b hairline-border py-16 px-4 bg-white">
    <div class="max-w-6xl mx-auto space-y-12">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <span id="clinic-spec-kicker" class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--accent)] font-semibold block mb-1">
            EXCELENCIA MÉDICA Y PRECISIÓN
          </span>
          <h2 id="clinic-spec-title" class="font-serif text-3xl sm:text-4xl text-stone-900 font-semibold">
            Nuestras Principales Especialidades
          </h2>
        </div>
        <p id="clinic-spec-desc" class="text-stone-600 text-sm max-w-md">
          Atención integral con especialistas dedicados en cada rama para garantizar resultados duraderos, estéticos y funcionales.
        </p>
      </div>

      <div id="clinic-specialties-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Tarjeta 1: Ortodoncia -->
        <div class="border hairline-border p-6 rounded-sm bg-gradient-to-b from-stone-50/50 to-white hover:border-[var(--accent)] transition-all group hover:shadow-lg">
          <div class="w-12 h-12 rounded-full bg-cyan-100 flex items-center justify-center text-cyan-800 mb-4 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4c-3.5 0-6 2.5-6 6 0 3 1.5 5.5 2.5 8 .5 1.2 1.2 2 2 2h3c.8 0 1.5-.8 2-2 1-2.5 2.5-5 2.5-8 0-3.5-2.5-6-6-6zM9 11h6" />
            </svg>
          </div>
          <span class="font-mono text-[10px] text-cyan-800 uppercase tracking-widest font-semibold block mb-1">ALINEACIÓN PERFECTA</span>
          <h3 class="font-serif text-lg font-semibold text-stone-900 mb-2">Ortodoncia &amp; Brackets</h3>
          <p class="text-xs text-stone-600 leading-relaxed">
            Brackets metálicos, estéticos de zafiro y autoligado rápido. Corrige tu mordida y alinea tu sonrisa sin molestias innecesarias.
          </p>
          <div class="mt-4 pt-3 border-t hairline-border flex items-center justify-between text-xs font-mono">
            <span class="text-stone-500">Evaluación inicial</span>
            <span class="font-semibold text-[var(--accent)]">Desde S/ 150/mes</span>
          </div>
        </div>

        <!-- Tarjeta 2: Estética y Blanqueamiento -->
        <div class="border hairline-border p-6 rounded-sm bg-gradient-to-b from-stone-50/50 to-white hover:border-[var(--accent)] transition-all group hover:shadow-lg">
          <div class="w-12 h-12 rounded-full bg-amber-100 flex items-center justify-center text-amber-600 mb-4 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5 2a1 1 0 011 1v1h1a1 1 0 010 2H6v1a1 1 0 01-2 0V6H3a1 1 0 010-2h1V3a1 1 0 011-1zm0 10a1 1 0 011 1v1h1a1 1 0 110 2H6v1a1 1 0 11-2 0v-1H3a1 1 0 110-2h1v-1a1 1 0 011-1zM12 2a1 1 0 01.967.744L14.146 7.2 17.5 9.134a1 1 0 010 1.732l-3.354 1.935-1.18 4.455a1 1 0 01-1.933 0L9.854 12.8 6.5 10.866a1 1 0 010-1.732l3.354-1.935 1.18-4.455A1 1 0 0112 2z" clip-rule="evenodd" />
            </svg>
          </div>
          <span class="font-mono text-[10px] text-amber-800 uppercase tracking-widest font-semibold block mb-1">BRILLO NATURAL</span>
          <h3 class="font-serif text-lg font-semibold text-stone-900 mb-2">Estética &amp; Blanqueamiento</h3>
          <p class="text-xs text-stone-600 leading-relaxed">
            Blanqueamiento LED en 1 sola sesión de 45 min y carillas de resina de alta estética. Recupera el tono blanco natural sin dañar tu esmalte.
          </p>
          <div class="mt-4 pt-3 border-t hairline-border flex items-center justify-between text-xs font-mono">
            <span class="text-stone-500">1 Sesión completa</span>
            <span class="font-semibold text-[var(--accent)]">Desde S/ 250</span>
          </div>
        </div>

        <!-- Tarjeta 3: Implantes & Cirugía -->
        <div class="border hairline-border p-6 rounded-sm bg-gradient-to-b from-stone-50/50 to-white hover:border-[var(--accent)] transition-all group hover:shadow-lg">
          <div class="w-12 h-12 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-700 mb-4 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 7a3 3 0 01-6 0L8 4zm4 10v7m-3 0h6" />
            </svg>
          </div>
          <span class="font-mono text-[10px] text-emerald-800 uppercase tracking-widest font-semibold block mb-1">REHABILITACIÓN ORAL</span>
          <h3 class="font-serif text-lg font-semibold text-stone-900 mb-2">Implantes &amp; Cirugía</h3>
          <p class="text-xs text-stone-600 leading-relaxed">
            Implantes de titanio grado quirúrgico, extracción indolora de terceros molares y coronas de circonio de máxima resistencia.
          </p>
          <div class="mt-4 pt-3 border-t hairline-border flex items-center justify-between text-xs font-mono">
            <span class="text-stone-500">Titanio garantizado</span>
            <span class="font-semibold text-[var(--accent)]">Diagnóstico 3D</span>
          </div>
        </div>

        <!-- Tarjeta 4: Cuidado Integral -->
        <div class="border hairline-border p-6 rounded-sm bg-gradient-to-b from-stone-50/50 to-white hover:border-[var(--accent)] transition-all group hover:shadow-lg">
          <div class="w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center text-blue-700 mb-4 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <span class="font-mono text-[10px] text-blue-800 uppercase tracking-widest font-semibold block mb-1">PREVENCIÓN Y SALUD</span>
          <h3 class="font-serif text-lg font-semibold text-stone-900 mb-2">Odontología Integral</h3>
          <p class="text-xs text-stone-600 leading-relaxed">
            Limpieza ultrasónica, curaciones estéticas con resina 3M, endodoncia mecanizada y atención odontopediátrica con trato cariñoso.
          </p>
          <div class="mt-4 pt-3 border-t hairline-border flex items-center justify-between text-xs font-mono">
            <span class="text-stone-500">Toda la familia</span>
            <span class="font-semibold text-[var(--accent)]">Desde S/ 80</span>
          </div>
        </div>
      </div>
    </div>
