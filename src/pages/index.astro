---
import Layout from '../layouts/Layout.astro';
import AgencyBar from '../components/AgencyBar.astro';
import PitchModal from '../components/PitchModal.astro';
import TopBar from '../components/TopBar.astro';
import NavBar from '../components/NavBar.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import MenuSection from '../components/MenuSection.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import LocationSection from '../components/LocationSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <!-- Barra de prospección interna de agencia -->
  <AgencyBar />

  <!-- Modal generador de propuesta lista para WhatsApp y Correo -->
  <PitchModal />

  <!-- Cintillo superior con dirección y rating -->
  <TopBar />

  <!-- Cabecera de navegación editorial -->
  <NavBar />

  <!-- Hero principal asimétrico y tipográfico -->
  <Hero />

  <!-- Cinta rotativa con badges de confianza -->
  <Marquee />

  <!-- Carta / Tarifario dinámico interactivo con carrito -->
  <MenuSection />

  <!-- Comparador antes/después con slider táctil -->
  <BeforeAfter />

  <!-- Ubicación con mapa dinámico de Google y reseñas -->
  <LocationSection />

  <!-- Pie de página editorial -->
  <Footer />

  <script src="../scripts/client.ts"></script>
</Layout>
