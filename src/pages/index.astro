---
import Layout from '../layouts/Layout.astro';
import AgencyBar from '../components/AgencyBar.astro';
import PitchModal from '../components/PitchModal.astro';
import BennyCustomView from '../components/BennyCustomView.astro';

// Componentes originales para el resto de prospectos
import TopBar from '../components/TopBar.astro';
import NavBar from '../components/NavBar.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import MenuSection from '../components/MenuSection.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import LocationSection from '../components/LocationSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <!-- Barra de prospección interna de agencia -->
  <AgencyBar />

  <!-- Modal generador de propuesta lista para WhatsApp y Correo -->
  <PitchModal />

  <!-- Vista personalizada exclusiva para Benny Salón & Spa con Framer Motion -->
  <div id="benny-prototype-view">
    <BennyCustomView />
  </div>

  <!-- Vista estándar original para todos los demás prospectos del sistema -->
  <div id="general-prototype-view" style="display: none;">
    <!-- Cintillo superior con dirección y rating -->
    <TopBar />

    <!-- Cabecera de navegación editorial original -->
    <NavBar />

    <!-- Hero principal asimétrico y tipográfico original -->
    <Hero />

    <!-- Cinta rotativa con badges de confianza original -->
    <Marquee />

    <!-- Carta / Tarifario dinámico interactivo con carrito original -->
    <MenuSection />

    <!-- Comparador antes/después con slider táctil original -->
    <BeforeAfter />

    <!-- Ubicación con mapa dinámico de Google y reseñas original -->
    <LocationSection />

    <!-- Pie de página editorial original -->
    <Footer />

    <!-- Botón flotante WhatsApp interactivo para la vista general -->
    <div class="fixed bottom-6 right-6 z-40">
      <a
        id="general-floating-wa"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2.5 px-4 py-3 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white shadow-xl hover:shadow-2xl transition-all duration-300 font-mono text-xs uppercase tracking-wider group hover:scale-105"
        title="Consultar disponibilidad por WhatsApp"
      >
        <span class="w-2.5 h-2.5 rounded-full bg-white animate-pulse"></span>
        <span class="font-bold">WhatsApp Directo</span>
      </a>
    </div>
  </div>

  <script src="../scripts/client.ts"></script>
</Layout>
